# Next.js reads .env.local — copy the two NEXT_PUBLIC_* vars there.
# The Prisma CLI only auto-loads a plain .env — copy DATABASE_URL and
# DIRECT_URL there too (same values work in both files if you prefer
# to just duplicate all four into both .env and .env.local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
DIRECT_URL=
